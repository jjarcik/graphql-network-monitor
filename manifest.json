{
  "manifest_version": 3,
  "name": "GraphQL Network Monitor",
  "version": "1.2.0",
  "description": "DevTools panel that monitors GraphQL operations and fetch/XHR requests with formatted queries, variables and responses.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "webRequest",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
